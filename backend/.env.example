# CORS Configuration (comma-separated origins or JSON array)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./cineverse.db

# Server
HOST=0.0.0.0
PORT=8000
